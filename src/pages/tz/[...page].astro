---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsPreview from '../../components/NewsPreview.astro';
import Pagination from '../../components/Pagination.astro';
import { getCollection } from 'astro:content';

export const getStaticPaths = (async ({ paginate }) => {
  const entries = await getCollection('press-releases', (e) => !e.data.draft);
  entries.sort(
    (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0),
  );
  return paginate(entries, { pageSize: 20 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

const indexTitle = 'Tiskové zprávy';
const description = 'Tiskové zprávy a novinky pro média od dětského ombudsmana.';
---
<BaseLayout title={indexTitle} description={description}>
  <main>
    <article>
      <h1>{indexTitle}</h1>
      <div class="text-content">
        {page.data.map((e) => (
          <NewsPreview
            href={`/tz/${e.id}/`}
            title={e.data.title}
            date={e.data.date}
            perex={e.data.perex}
            pic={e.data.pic}
            icon={e.data.icon}
            h={2}
            filePath={e.filePath}
          />
        ))}

        <Pagination
          currentPage={page.currentPage}
          lastPage={page.lastPage}
          url={page.url}
          baseUrl="/tz/"
        />
      </div>
    </article>
  </main>
</BaseLayout>
