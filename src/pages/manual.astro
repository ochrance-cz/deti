---
import BaseLayout from '../layouts/BaseLayout.astro';
const icons = ["vikend.svg", "proc.svg", "jak-dlouho.svg", "vzali-me.svg", "prisnejsi.svg", "navstevy.svg", "sam-ven.svg", "alkohol.svg", "mobil.svg", "wifi.svg", "kontrolovat.svg", "zamykat.svg", "soukromi.svg", "ss.svg", "kapesne.svg", "vyzdobit.svg", "pujcovani.svg", "vzhled.svg", "18.svg", "nelibi.svg", "napsat.svg", "lecba.png", "nemocnice.png", "nesouhlas.png", "soud.png"];
---
<BaseLayout title="Dostupné piktogramy" noIndex={true}>
  <main><article><h1>Dostupné piktogramy</h1>
    <ul>{icons.map(icon => <li><img src={`/images/domov/${icon}`} alt="" width="64" height="64" />{icon}</li>)}</ul>
  </article></main>
</BaseLayout>
