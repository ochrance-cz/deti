---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Hledání">
  <main class="_pagefind">
    <article>
      <h1>Hledání</h1>
      <div class="text-content">
        <div id="search"></div>
      </div>

      <script is:inline src="/pagefind/pagefind-ui.js"></script>
      <script is:inline>
        window.addEventListener('DOMContentLoaded', () => {
          new PagefindUI({
            element: '#search',
            excerptLength: 30,
            showSubResults: true,
            showImages: false,
            translations: {
              placeholder:
                document.querySelector('html').getAttribute('lang') === 'en'
                  ? 'Search…'
                  : 'Hledat…',
            },
          });
        });
      </script>
    </article>
  </main>
</BaseLayout>
