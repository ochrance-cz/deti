---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

const [page] = await getCollection('hledam-pomoc');

if (!page) {
  throw new Error('Missing hledam-pomoc entry');
}

// Způsoby kontaktu vkládá do textu remark plugin src/remark/contact-list.ts.
const { Content } = await render(page);
---
<BaseLayout title={page.data.title} bodyClass="_contact-page">
  <main>
    <article>
      <h1>{page.data.title}</h1>

      <div class="text-content contact-details"><Content /></div>
    </article>
  </main>
</BaseLayout>
