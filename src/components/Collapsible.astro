---
interface Props {
  id: string;
  title: string;
  icon?: string;
  open?: boolean;
}
const { id, title, icon, open = false } = Astro.props;
---
<div class="_collapsible">
  <input type="checkbox" id={id} checked={open}>
  <div class="box">
    <h3 class="title">
      <span class="chevron" aria-hidden="true"></span>
      <label role="button" tabindex="0" class="opener" for={id} aria-controls={`${id}-content`} aria-expanded={open ? 'true' : 'false'}>
        {icon && (
          <span class="icon-wrapper">
            <img class="icon" src={`/images/domov/${icon}`}>
          </span>
        )}
        {title}
      </label>
    </h3>
    <div class="content" id={`${id}-content`}>
      <slot />
    </div>
  </div>
</div>
