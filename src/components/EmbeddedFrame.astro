---
interface Props {
  src: string;
  title?: string;
  width?: string;
  height?: string;
  frameborder?: string;
  allow?: string;
  allowfullscreen?: boolean;
  responsive?: boolean;
}

const { src, title, width, height, frameborder, allow, allowfullscreen, responsive = false } = Astro.props;
---
<div class="embedded-frame">
<div class:list={['embedded-frame-media', { responsive }]}>
<iframe
  src={src}
  title={title}
  width={width}
  height={height}
  frameborder={frameborder}
  allow={allow}
  allowfullscreen={allowfullscreen}
></iframe>
</div>
<p class="embedded-frame-link">
  {src.includes('google.com/maps')
    ? <a href={src} target="_blank" rel="noopener">Otevřít mapu samostatně</a>
    : <a href={src} target="_blank" rel="noopener">Otevřít video samostatně</a>}
</p>
</div>

<style>
  iframe { max-width: 100%; }
  .responsive { position: relative; aspect-ratio: 16 / 9; }
  .responsive iframe { position: absolute; width: 100%; height: 100%; border: 0; }
  .embedded-frame-link { margin: 0.5rem 0 1.5rem; }
</style>
