---
import { Image } from '@nuasite/components';
import { galleryPreview, type GalleryImage } from '../lib/gallery';
interface Props { items?: GalleryImage[]; label?: string; layout?: 'editorial' | 'media' }
const { items = [], label = 'Fotogalerie', layout = 'editorial' } = Astro.props;
---
{(items.length > 0 || Astro.slots.has('default')) && <div class:list={['editorial-gallery', { 'media-gallery': layout === 'media' }]} role="group" aria-label={label}>
  <ul class="gallery-grid">
    <slot />
    {items.map((item) => <li>
      <figure>
        <button type="button" class="gallery-open" data-src={galleryPreview(item.pic)} data-download={item.download} aria-haspopup="dialog">
          <Image src={item.pic} alt={item.alt} widths={[320, 640, 1200]} sizes="(max-width: 600px) 90vw, 800px" />
        </button>
        {item.caption && <figcaption>{item.caption}</figcaption>}
      </figure>
    </li>)}
  </ul>
  <dialog class="gallery-dialog" aria-label={label}>
    <button type="button" class="gallery-close" aria-label="Zavřít galerii">×</button>
    <figure class="gallery-stage">
      <img class="gallery-full" alt="" />
      <figcaption><span class="gallery-caption"></span><a class="gallery-download" download hidden>(stáhnout v plném rozlišení)</a></figcaption>
    </figure>
    <button type="button" class="gallery-prev" aria-label="Předchozí fotografie"><img src="/images/arrow-left.svg" alt="" /></button>
    <button type="button" class="gallery-next" aria-label="Další fotografie"><img src="/images/arrow-right.svg" alt="" /></button>
    <div class="gallery-thumbnails" aria-label="Výběr fotografie"></div>
    <span class="gallery-position" aria-live="polite"></span>
  </dialog>
</div>}
<script is:inline>
  (() => {
    if (window.__ochranceGalleryEvents) return;
    window.__ochranceGalleryEvents = true;
    const states = new WeakMap();
    const show = (gallery, next) => {
      const buttons = Array.from(gallery.querySelectorAll('.gallery-open'));
      const index = (next + buttons.length) % buttons.length;
      const dialog = gallery.querySelector('dialog');
      const button = buttons[index];
      const originalImage = button.querySelector('img');
      const image = dialog.querySelector('.gallery-full');
      image.src = button.dataset.src || originalImage.currentSrc || originalImage.src;
      image.alt = originalImage.alt;
      dialog.querySelector('.gallery-caption').textContent = button.closest('figure').querySelector('figcaption')?.textContent || '';
      const download = dialog.querySelector('.gallery-download');
      download.hidden = !button.dataset.download;
      if (button.dataset.download) download.href = button.dataset.download;
      else download.removeAttribute('href');
      dialog.querySelector('.gallery-position').textContent = `${index + 1} / ${buttons.length}`;
      const thumbnails = dialog.querySelector('.gallery-thumbnails');
      if (!thumbnails.children.length) buttons.forEach((source, i) => {
        const thumbnail = document.createElement('button');
        thumbnail.type = 'button';
        thumbnail.setAttribute('aria-label', `Fotografie ${i + 1}: ${source.querySelector('img').alt}`);
        const thumbImage = source.querySelector('img').cloneNode();
        thumbImage.alt = '';
        thumbnail.append(thumbImage);
        thumbnails.append(thumbnail);
      });
      Array.from(thumbnails.children).forEach((thumbnail, i) => thumbnail.setAttribute('aria-pressed', String(i === index)));
      const state = states.get(gallery) || {};
      state.index = index;
      states.set(gallery, state);
    };
    document.addEventListener('click', event => {
      if (!(event.target instanceof Element)) return;
      const gallery = event.target.closest('.editorial-gallery');
      if (!gallery) return;
      const dialog = gallery.querySelector('dialog');
      const opener = event.target.closest('.gallery-open');
      if (opener) {
        states.set(gallery, { opener, index: 0 });
        show(gallery, Array.from(gallery.querySelectorAll('.gallery-open')).indexOf(opener));
        dialog.showModal();
        return;
      }
      if (event.target.closest('.gallery-close') || event.target === dialog) dialog.close();
      else if (event.target.closest('.gallery-prev')) show(gallery, (states.get(gallery)?.index || 0) - 1);
      else if (event.target.closest('.gallery-next')) show(gallery, (states.get(gallery)?.index || 0) + 1);
      else {
        const thumbnail = event.target.closest('.gallery-thumbnails button');
        if (thumbnail) show(gallery, Array.from(thumbnail.parentElement.children).indexOf(thumbnail));
      }
    });
    document.addEventListener('keydown', event => {
      if (!(event.target instanceof Element)) return;
      const gallery = event.target.closest('.editorial-gallery');
      if (!gallery?.querySelector('dialog').open) return;
      if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
        event.preventDefault();
        show(gallery, (states.get(gallery)?.index || 0) + (event.key === 'ArrowLeft' ? -1 : 1));
      }
    });
    document.addEventListener('close', event => {
      if (!(event.target instanceof HTMLDialogElement) || !event.target.matches('.gallery-dialog')) return;
      const gallery = event.target.closest('.editorial-gallery');
      event.target.querySelector('.gallery-full').removeAttribute('src');
      states.get(gallery)?.opener?.focus();
    }, true);
  })();
</script>
<style>
  .editorial-gallery { margin: 2rem 0; }
  .gallery-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; padding: 0; list-style: none; }
  .gallery-grid :global(li) { padding: 0; margin: 0; min-width: 0; }
  .gallery-grid :global(li::before) { display: none; }
  .gallery-grid :global(li:first-child) { grid-column: 1 / -1; margin-bottom: .5rem; }
  :global(.gallery-grid figure) { margin: 0; }
  :global(.gallery-open) { display: block; width: 100%; padding: 0; border: 0; border-radius: .5rem; overflow: hidden; background: transparent; cursor: pointer; }
  :global(.gallery-open img) { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; display: block; }
  .gallery-grid :global(li:first-child img) { aspect-ratio: auto; object-fit: contain; }
  .gallery-grid :global(figcaption) { padding: .5rem 0; font-size: 1rem; }
  .media-gallery .gallery-grid { display: flex; flex-direction: row; flex-wrap: nowrap; gap: 1rem; overflow-x: auto; padding-bottom: 1rem; }
  .media-gallery .gallery-grid :global(li) { flex: 0 0 auto; width: auto; margin: 0; }
  .media-gallery :global(.gallery-open) { width: auto; }
  .media-gallery :global(.gallery-open img) { height: 11rem; width: auto; max-width: none; aspect-ratio: auto; object-fit: contain; }
  .gallery-dialog { position: fixed; inset: 0; margin: 0; width: 100%; height: 100dvh; max-width: none; max-height: none; padding: 0; border: 0; border-radius: 0; background: rgb(0 0 0 / 80%); color: white; overflow: hidden; }
  :global(html:has(.gallery-dialog[open])) { overflow: hidden; }
  :global(body:has(.gallery-dialog[open])) { overflow: hidden; }
  .gallery-dialog::backdrop { background: transparent; }
  .gallery-stage { position: absolute; inset: 5rem 5rem 25vh; margin: 0; text-align: center; pointer-events: none; }
  .gallery-full { display: block; max-width: 100%; max-height: calc(100% - 3rem); width: auto; height: auto; margin: auto; object-fit: contain; }
  .gallery-stage figcaption { padding: .5rem; }
  .gallery-stage a { color: white; pointer-events: auto; }
  .gallery-close { position: absolute; right: 1rem; top: 1rem; color: white; font-size: 2rem; background: transparent; border: 0; }
  .gallery-prev, .gallery-next { position: absolute; top: 35vh; left: 2rem; width: 3rem; height: 3rem; background: transparent; border: 0; padding: 0; }
  .gallery-next { left: auto; right: 2rem; }
  .gallery-prev img, .gallery-next img { width: 100%; height: 100%; object-fit: contain; }
  .gallery-dialog button { min-width: 44px; min-height: 44px; cursor: pointer; }
  .gallery-thumbnails { position: absolute; top: 80vh; left: 50%; transform: translateX(-50%); display: flex; gap: 1rem; max-width: 95vw; overflow-x: auto; }
  .gallery-thumbnails :global(button) { flex: 0 0 10vh; width: 10vh; height: 10vh; border: 2px solid #999; border-radius: .25rem; padding: 0; background: transparent; overflow: hidden; }
  .gallery-thumbnails :global(button[aria-pressed='true']) { border-color: #0674d4; }
  .gallery-thumbnails :global(img) { width: 100%; height: 100%; display: block; object-fit: cover; }
  .gallery-position { position: absolute; bottom: 1rem; width: 100%; text-align: center; }
  :global(.gallery-open:focus-visible), .gallery-dialog :global(button:focus-visible) { outline: 3px solid #0674d4; outline-offset: 3px; }
  :global(.gallery-open:hover) { opacity: .85; }
  .gallery-download[hidden] { display: none; }
  @media (max-width: 600px) {
    .gallery-grid { gap: .5rem; }
    .gallery-stage { inset: 4rem 3.25rem 25vh; }
    .gallery-prev { left: .25rem; }
    .gallery-next { right: .25rem; }
    .gallery-thumbnails { gap: .5rem; }
  }
</style>
