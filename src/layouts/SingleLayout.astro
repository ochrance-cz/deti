---
import BaseLayout from './BaseLayout.astro';
import DateLabel from '../components/DateLabel.astro';
import LinkList from '../components/LinkList.astro';
import { renderMarkdown } from '../lib/markdown';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  date?: Date | string;
  perex?: string;
  image?: string | ImageMetadata;
  imageAlt?: string;
  attachments?: Array<{
    title?: string;
    text?: string;
    link?: string;
    file?: string;
  }>;
  noIndex?: boolean;
  /** Downloadable audio under the perex (typically a short quote for radio). */
  audio?: string;
  audioCaption?: string;
}

const { title, date, perex, image, imageAlt, attachments, noIndex = false, audio, audioCaption } = Astro.props;
const perexHtml = perex ? await renderMarkdown(perex) : '';
---
<BaseLayout title={title} description={perex} image={image} imageAlt={imageAlt} noIndex={noIndex}>
  <main>
    <article>
      {date && (
        <p class="details">
          <DateLabel date={date} />
        </p>
      )}
      <h1>{title}</h1>
      <div class="text-content">
        {perexHtml && <div class="perex" set:html={perexHtml}></div>}

        {audio && (
          <div class="_audio-download _no-print">
            {audioCaption && <p><strong>{audioCaption}</strong></p>}
            <p>
              <a class="button" href={audio} download>Stáhnout audio</a>
            </p>
          </div>
        )}

        <slot />

        {attachments && attachments.length > 0 && (
          <LinkList items={attachments} />
        )}
      </div>
    </article>
  </main>
</BaseLayout>
