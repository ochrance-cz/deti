new file mode 100644
index 0000000000000000000000000000000000000000..8733edce5e597ad0164afa4fc5aa1e2664eb3799
--- /dev/null
+++ b/src/editor/image-schema.ts
@@ -0,0 +1,16 @@
+import { imageSchema } from '@milkdown/preset-commonmark'
+
+// Omitted Markdown image titles are null in remark. Normalize that value before
+// Milkdown's string validation can reject and silently discard the photograph.
+export const safeImageSchema = imageSchema.extendSchema(previous => ctx => {
+	const schema = previous(ctx)
+	return {
+		...schema,
+		parseMarkdown: {
+			...schema.parseMarkdown,
+			runner: (state, node, type) => schema.parseMarkdown.runner(state, {
+				...node, alt: node.alt ?? '', title: node.title ?? '',
+			}, type),
+		},
+	}
+})
