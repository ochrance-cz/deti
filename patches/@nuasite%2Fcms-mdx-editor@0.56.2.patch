diff --git a/src/history-plugin.ts b/src/history-plugin.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e7f80e1d72c88942acb30fd7e6b0cec8d81dcec1
--- /dev/null
+++ b/src/history-plugin.ts
@@ -0,0 +1,20 @@
+/**
+ * Undo/redo for the Milkdown editors. Milkdown ships this as the separate
+ * `@milkdown/plugin-history` package; we wire ProseMirror's history directly
+ * via `@milkdown/prose` so no extra dependency is needed.
+ */
+import { history, redo, undo } from '@milkdown/prose/history'
+import { keymap } from '@milkdown/prose/keymap'
+import { $prose } from '@milkdown/utils'
+
+export const historyPlugin = $prose(() => history())
+
+export const historyKeymap = $prose(() =>
+	keymap({
+		'Mod-z': undo,
+		'Mod-Shift-z': redo,
+		'Mod-y': redo,
+	})
+)
+
+export { redo, undo }
