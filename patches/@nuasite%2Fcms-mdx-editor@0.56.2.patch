diff --git a/src/image-schema.ts b/src/image-schema.ts
new file mode 100644
index 0000000000000000000000000000000000000000..a08ba09459c44b970b6838ab43bbed3007ba158f
--- /dev/null
+++ b/src/image-schema.ts
@@ -0,0 +1,17 @@
+import { imageSchema } from '@milkdown/preset-commonmark'
+
+// Remark represents an omitted image title as null. Milkdown 7.20 validates
+// image titles as strings but forwards that null, then silently drops the image
+// when ProseMirror rejects it. Normalize optional metadata before adding nodes.
+export const safeImageSchema = imageSchema.extendSchema(previous => ctx => {
+	const schema = previous(ctx)
+	return {
+		...schema,
+		parseMarkdown: {
+			...schema.parseMarkdown,
+			runner: (state, node, type) => schema.parseMarkdown.runner(state, {
+				...node, alt: node.alt ?? '', title: node.title ?? '',
+			}, type),
+		},
+	}
+})
diff --git a/src/mark-whitespace.ts b/src/mark-whitespace.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f15ffc8bfc2a11be82e8a90b02e8279cc5ba77ea
--- /dev/null
+++ b/src/mark-whitespace.ts
@@ -0,0 +1,66 @@
+import { remarkStringifyOptionsCtx } from '@milkdown/core'
+import type { Ctx } from '@milkdown/ctx'
+
+// Bold/italic must not start or end with whitespace in Markdown: `**Otázka?  **`
+// is not bold, and the site shows the asterisks literally. Milkdown moves plain
+// spaces out of a mark on save, but not a non-breaking space or a tab (typical of
+// text pasted from Word), so move any such edge whitespace outside the markers.
+// Line breaks stay inside: emitted outside, they could start a new block.
+
+type Handler = (node: any, parent: any, state: any, info: any) => string
+
+const MARKS = new Set(['strong', 'emphasis', 'delete'])
+const LEADING = /^[^\S\r\n]+/
+const TRAILING = /[^\S\r\n]+$/
+
+function edgeText(node: any, edge: 'first' | 'last'): any {
+	const children = node.children
+	if (!Array.isArray(children) || children.length === 0) return undefined
+	const child = edge === 'first' ? children[0] : children[children.length - 1]
+	if (child.type === 'text') return child
+	return MARKS.has(child.type) ? edgeText(child, edge) : undefined
+}
+
+function isEmpty(node: any): boolean {
+	if (node.type === 'text') return node.value === ''
+	return MARKS.has(node.type) && (node.children ?? []).every(isEmpty)
+}
+
+function prune(node: any): void {
+	if (!MARKS.has(node.type) || !Array.isArray(node.children)) return
+	node.children = node.children.filter((child: any) => !isEmpty(child))
+	node.children.forEach(prune)
+}
+
+function keepWhitespaceOutside(handler: Handler): Handler {
+	const wrapped: Handler = (node, parent, state, info) => {
+		const copy = structuredClone(node)
+		const first = edgeText(copy, 'first')
+		const leading = first?.value.match(LEADING)?.[0] ?? ''
+		if (leading) first.value = first.value.slice(leading.length)
+		const last = edgeText(copy, 'last')
+		const trailing = last?.value.match(TRAILING)?.[0] ?? ''
+		if (trailing) last.value = last.value.slice(0, -trailing.length)
+		if (!leading && !trailing) return handler(node, parent, state, info)
+
+		prune(copy)
+		if (isEmpty(copy)) return leading + trailing
+		return leading + handler(copy, parent, state, {
+			...info,
+			before: leading ? leading.slice(-1) : info.before,
+			after: trailing ? trailing[0] : info.after,
+		}) + trailing
+	}
+	return Object.assign(wrapped, { peek: (handler as any).peek })
+}
+
+/** Call from `Editor.make().config(...)`, before the serializer is created. */
+export function keepMarkWhitespaceOutside(ctx: Ctx): void {
+	ctx.update(remarkStringifyOptionsCtx, (options) => {
+		const handlers: Record<string, Handler> = { ...(options.handlers as Record<string, Handler>) }
+		for (const type of ['strong', 'emphasis']) {
+			if (handlers[type]) handlers[type] = keepWhitespaceOutside(handlers[type])
+		}
+		return { ...options, handlers }
+	})
+}
