--- /dev/null
+++ b/src/image-schema.ts
@@ -0,0 +1,17 @@
+import { imageSchema } from '@milkdown/preset-commonmark'
+
+// Remark represents an omitted image title as null. Milkdown 7.20 validates
+// image titles as strings but forwards that null, then silently drops the image
+// when ProseMirror rejects it. Normalize optional metadata before adding nodes.
+export const safeImageSchema = imageSchema.extendSchema(previous => ctx => {
+	const schema = previous(ctx)
+	return {
+		...schema,
+		parseMarkdown: {
+			...schema.parseMarkdown,
+			runner: (state, node, type) => schema.parseMarkdown.runner(state, {
+				...node, alt: node.alt ?? '', title: node.title ?? '',
+			}, type),
+		},
+	}
+})
